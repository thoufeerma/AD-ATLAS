# Copy to .env and fill in. .env is gitignored.

# ── Database ──────────────────────────────────────────────────────────────
# Option A — native PostgreSQL on 5432 (create the role + database first):
#   psql -U postgres -c "CREATE ROLE velastia WITH LOGIN PASSWORD 'velastia_dev' CREATEDB;"
#                    -c "CREATE DATABASE velastia OWNER velastia;"
DATABASE_URL="postgresql://velastia:velastia_dev@localhost:5432/velastia?schema=public"
#
# Option B — Docker (`npm run db:up`), which listens on 5433:
# DATABASE_URL="postgresql://velastia:velastia_dev@localhost:5433/velastia?schema=public"
#
# CREATEDB matters for both: `prisma migrate dev` creates a temporary shadow
# database. In production, point this at the managed database instead.

PORT=4000
NODE_ENV=development

# Origins allowed to call the API with credentials (comma-separated).
# Storefront dev server and admin dev server.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Secret for signing admin session tokens. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production without a strong one.
JWT_SECRET="replace-me-with-a-long-random-string"

# ── Email ──────────────────────────────────────────────────────────────────
# Order confirmations, shipping updates and admin alerts go through Resend
# (resend.com). Without a key nothing is sent: every email is kept in the
# admin's Email Log instead, so you can see exactly what customers would get.
# ── Razorpay ── without these, checkout offers cash on delivery only. On a
# development machine the API stands in for the gateway so the flow can be
# tried; that never happens in production.
# RAZORPAY_KEY_ID="rzp_test_..."
# RAZORPAY_KEY_SECRET="..."
# The secret you choose when adding the webhook in Razorpay, pointing at
# <this api>/api/v1/webhooks/razorpay
# RAZORPAY_WEBHOOK_SECRET="..."
# Development only: lets the API stand in for Razorpay, so checkout and the
# smoke tests can run without an account. Refused in production, against any
# database that isn't local, and whenever real keys are set.
ALLOW_PAYMENT_SIMULATOR=true

# RESEND_API_KEY="re_..."
# Sender. Must be on a domain you've verified in Resend. The default
# (onboarding@resend.dev) only delivers to your own Resend account's address.
# EMAIL_FROM="Velastia <orders@velastia.com>"
# ── Uploads ────────────────────────────────────────────────────────────────
# Images uploaded in the admin's Media Library are kept here (relative to
# backend/). Fine for development; most hosts wipe their disk on each deploy,
# so online they go to Supabase Storage instead (below).
# UPLOAD_DIR="uploads"
# MAX_UPLOAD_MB=10
#
# Online: a public Supabase Storage bucket. With both of these set, uploads go
# there instead of the disk. The key is a server secret (Project Settings →
# API Keys → secret key) — only ever in the API host's settings.
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# SUPABASE_BUCKET="media"

# ── Online only ────────────────────────────────────────────────────────────
# Supabase's CA certificate (PEM text, from Database → Settings → SSL), so the
# database connection is verified as well as encrypted. Without it, a URL with
# ?sslmode=require is still encrypted.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
# The same random value on the API, the store and the admin. The two websites
# forward browser requests to the API and use it to pass on each visitor's
# real IP address for rate limits. Required when NODE_ENV=production.
# PROXY_SECRET="..."

# Where the two sites live — used for links and the logo inside emails.
STORE_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# First Super Administrator, created by `npm run db:seed` if no admin exists.
SEED_ADMIN_EMAIL="admin@velastia.com"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
