// Velastia data model.
//
// Conventions
// - Money is ALWAYS integer paise (₹799 → 79900). Never floats: they corrupt
//   money through rounding, and Razorpay speaks paise natively.
// - Percentages are integer basis points where precision matters (18% → 1800).
// - Orders snapshot product name, SKU, price and shipping address at purchase
//   time, so later catalog edits never rewrite a customer's order history.
// - Tables are snake_case in Postgres; models stay PascalCase in code.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ───────────────────────────── Catalog ───────────────────────────── */

enum ProductStatus {
  ACTIVE
  DRAFT
  COMING_SOON
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id                String         @id @default(cuid())
  slug              String         @unique
  sku               String         @unique
  name              String
  /// Short "Brightens · Hydrates · Repairs" line shown on cart and wishlist rows
  descriptor        String?
  blurb             String?
  size              String?
  pricePaise        Int
  compareAtPaise    Int?
  /// GST classification, printed on invoices. 3304 covers make-up and
  /// skin-care preparations.
  hsnCode           String         @default("3304")
  /// GST rate in basis points (1800 = 18%). Prices already include it.
  gstRateBps        Int            @default(1800)
  status            ProductStatus  @default(DRAFT)
  isBestseller      Boolean        @default(false)
  /// Stock is tracked per product for now, not per shade.
  stock             Int            @default(0)
  lowStockThreshold Int            @default(15)
  benefits          String[]
  /// Packed weight, for courier bookings and labels. Null until someone weighs it.
  weightGrams       Int?
  metaTitle         String?
  metaDescription   String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images     ProductImage[]
  shades     Shade[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlistedBy WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Shade {
  id        String  @id @default(cuid())
  code      String
  name      String
  hex       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
  @@map("shades")
}

/* ──────────────────────────── Customers ──────────────────────────── */

model Customer {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  phone        String?
  /// Null for customers who have only checked out as guests.
  passwordHash String?
  /// Set once they've clicked the emailed link (or reset their password).
  /// Order history stays hidden until then: guest orders are linked by
  /// email, so signing up with an address mustn't be enough to read them.
  emailVerifiedAt DateTime?
  /// Stamped into session tokens; bumped on password change/reset.
  sessionVersion Int @default(0)
  lastLoginAt  DateTime?
  tokens       CustomerToken[]
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("customers")
}

model Address {
  id         String   @id @default(cuid())
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("addresses")
}

model WishlistItem {
  customerId String
  productId  String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([customerId, productId])
  @@map("wishlist_items")
}

/* ───────────────────────────── Orders ────────────────────────────── */

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
}

model Order {
  id            String         @id @default(cuid())
  /// Customer-facing number, e.g. VL25052978
  number        String         @unique
  email         String
  status        OrderStatus    @default(PENDING)
  paymentStatus PaymentStatus  @default(PENDING)
  paymentMethod PaymentMethod?

  subtotalPaise Int
  discountPaise Int @default(0)
  shippingPaise Int @default(0)
  taxPaise      Int @default(0)
  totalPaise    Int
  couponCode    String?
  /// Shipping method as chosen at checkout (snapshots, like the address).
  shippingMethod String?
  shippingEta    String?

  /// Who is carrying it and under what number, filled in when the order ships.
  /// Courier-agnostic on purpose: typed in by hand today, written by a
  /// courier's API later without changing anything that reads them.
  courierName    String?
  trackingNumber String?
  /// Where the customer can follow it; built from the courier's own page.
  trackingUrl    String?

  // Shipping address snapshot — deliberately not a relation to Address.
  shipName    String
  shipPhone   String
  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipState   String
  shipPincode String
  shipCountry String @default("India")

  razorpayOrderId   String? @unique
  razorpayPaymentId String?

  /// GST tax invoice, e.g. VL/2627/00001 — issued when the order ships, or
  /// earlier from the admin. Numbers run in sequence within a financial year.
  invoiceNumber String?   @unique
  invoicedAt    DateTime?
  /// The seller's details as they were on the day of issue (name, GSTIN,
  /// address, state), so a later change of address never alters old invoices.
  invoiceSeller Json?

  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  events     OrderEvent[]
  returns    ReturnRequest[]
  creditNotes CreditNote[]

  placedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([email])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  // Snapshots, so a later rename or price change never alters past orders.
  productName    String
  sku            String
  shadeName      String?
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int
  /// The product's GST classification and rate when it was bought.
  hsnCode        String
  gstRateBps     Int

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  returns   ReturnItem[]

  @@index([orderId])
  @@map("order_items")
}

/// A customer asking to send part (or all) of a delivered order back.
/// Money is never moved here — the team records the refund once it's paid.
model ReturnRequest {
  id     String       @id @default(cuid())
  /// Customer-facing reference, e.g. RT2609201234
  number String       @unique
  status ReturnStatus @default(REQUESTED)
  reason ReturnReason
  /// The customer's own words.
  note      String?
  /// What the team replied; it goes into the update email.
  staffNote String?
  /// What was actually refunded, set when the request is settled.
  refundPaise Int?
  /// Razorpay's refund id, when the money went back through the gateway.
  /// Null for cash on delivery, which is refunded by hand.
  gatewayRefundId String?

  orderId String
  order   Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   ReturnItem[]
  /// Issued when the refund is recorded, if the order had a GST invoice.
  creditNote CreditNote?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  @@index([orderId])
  @@index([status])
  @@map("return_requests")
}

model ReturnItem {
  id       String @id @default(cuid())
  quantity Int

  requestId   String
  request     ReturnRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([requestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

/// The status timeline behind Track Order.
model OrderEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  note      String?
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_events")
}

/* ─────────────────────────── Promotions ──────────────────────────── */

enum ReturnStatus {
  /// Waiting for the team to look at it.
  REQUESTED
  /// Send it back — the customer has been told how.
  APPROVED
  REJECTED
  /// The parcel is back with us.
  RECEIVED
  /// Money returned; the request is closed.
  REFUNDED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  REACTION
  CHANGED_MIND
  OTHER
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  type             CouponType
  /// PERCENTAGE: basis points (1000 = 10%). FIXED: paise. FREE_SHIPPING: ignored.
  value            Int        @default(0)
  minOrderPaise    Int        @default(0)
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int        @default(0)
  firstOrderOnly   Boolean    @default(false)
  isActive         Boolean    @default(true)
  startsAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("coupons")
}

model Offer {
  id        String   @id @default(cuid())
  name      String
  scope     String
  isActive  Boolean  @default(true)
  startsAt  DateTime
  endsAt    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")
}

model ShippingMethod {
  id             String  @id @default(cuid())
  name           String
  eta            String
  pricePaise     Int
  /// Free when the post-discount subtotal reaches this. Null = never free.
  freeAbovePaise Int?
  isEnabled      Boolean @default(true)
  sortOrder      Int     @default(0)

  @@map("shipping_methods")
}

/// The last number used in each numbered series, per financial year:
/// "INV-2627" for invoices issued April 2026 to March 2027, "CN-2627" for
/// credit notes. Incremented inside the transaction that issues the document,
/// so numbers never repeat or skip.
model DocumentSequence {
  series     String @id
  lastNumber Int

  @@map("document_sequences")
}

enum CreditNoteReason {
  /// Items sent back and refunded.
  RETURN
  /// An invoiced order called off before delivery.
  CANCELLATION
  /// An order refunded as a whole.
  REFUND
}

/// A GST credit note: takes back part or all of an order's invoice when money
/// is returned. Unlike the invoice, its lines are stored as issued, because
/// they depend on what was refunded that day.
model CreditNote {
  id     String           @id @default(cuid())
  /// e.g. CN/2627/00001
  number String           @unique
  reason CreditNoteReason

  orderId       String
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnId      String?        @unique
  returnRequest ReturnRequest? @relation(fields: [returnId], references: [id], onDelete: SetNull)

  /// The credited lines (CreditLine[] in lib/creditNotes.ts), frozen.
  lines        Json
  taxablePaise Int
  cgstPaise    Int
  sgstPaise    Int
  igstPaise    Int
  totalPaise   Int
  issuedAt     DateTime @default(now())

  @@index([orderId])
  @@index([issuedAt])
  @@map("credit_notes")
}

/* ───────────────────────────── Reviews ───────────────────────────── */

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  authorName String
  rating     Int
  body       String
  status     ReviewStatus @default(PENDING)
  isVerified Boolean      @default(false)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime     @default(now())

  @@index([productId, status])
  @@map("reviews")
}

/* ───────────────────────────── Content ───────────────────────────── */

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  /// Structured sections; shape is owned by the page type.
  body            Json
  status          PublishStatus @default(DRAFT)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("pages")
}

model BlogPost {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  body        String
  author      String
  coverUrl    String?
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("blog_posts")
}

model Banner {
  id        String   @id @default(cuid())
  name      String
  placement String
  headline  String?
  imageUrl  String?
  href      String?
  isActive  Boolean  @default(true)
  clicks    Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Testimonial {
  id         String   @id @default(cuid())
  author     String
  role       String
  rating     Int      @default(5)
  quote      String
  avatarUrl  String?
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("testimonials")
}

model Collaborator {
  id        String  @id @default(cuid())
  name      String
  role      String
  avatarUrl String?
  sortOrder Int     @default(0)

  @@map("collaborators")
}

model Faq {
  id          String  @id @default(cuid())
  question    String
  answer      String
  category    String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  @@map("faqs")
}

/// An uploaded image. Stored re-encoded (WebP, metadata stripped); `url` is
/// what pages use, `storageKey` where the file lives in storage.
model MediaAsset {
  id         String   @id @default(cuid())
  /// The name it was uploaded with, for people to recognise it.
  filename   String
  url        String   @unique
  storageKey String   @unique
  alt        String?
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())

  @@map("media_assets")
}

/* ─────────────────────────── Marketing ───────────────────────────── */

enum SubscriberStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

model Subscriber {
  id        String           @id @default(cuid())
  email     String           @unique
  source    String?
  status    SubscriberStatus @default(SUBSCRIBED)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("subscribers")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  AUTOMATED
}

model Campaign {
  id           String         @id @default(cuid())
  name         String
  subject      String?
  status       CampaignStatus @default(DRAFT)
  sentCount    Int            @default(0)
  openedCount  Int            @default(0)
  clickedCount Int            @default(0)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("campaigns")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  isHandled Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model CollabApplication {
  id           String   @id @default(cuid())
  name         String
  email        String
  handle       String
  audienceSize String?
  about        String
  isReviewed   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("collab_applications")
}

/* ──────────────────────────── System ─────────────────────────────── */

enum AdminRole {
  SUPER_ADMIN
  CONTENT_MANAGER
  ORDER_MANAGER
  SUPPORT_AGENT
}

model AdminUser {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  role         AdminRole
  isActive     Boolean       @default(true)
  /// Set for new accounts and admin-issued resets; the panel is blocked
  /// until the admin picks their own password.
  mustChangePassword Boolean @default(false)
  /// Stamped into every session token. Bumping it (password change, reset,
  /// deactivation) signs that admin out everywhere.
  sessionVersion Int         @default(0)
  lastLoginAt  DateTime?
  activity     ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("admin_users")
}

model ActivityLog {
  id          String     @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@map("activity_logs")
}

/// Key/value store settings: store details, free-shipping threshold, etc.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/* ───────────────────────────── Email ─────────────────────────────── */

enum EmailStatus {
  SENT
  FAILED
  /// Kept here but not sent: no email service connected, or a test address.
  CAPTURED
}

/// Every email the store sends (or would have sent), for the admin's Email Log.
model EmailLog {
  id         String      @id @default(cuid())
  to         String
  subject    String
  /// order.confirmation, order.status, alert.order, alert.message, alert.collab, test
  kind       String
  status     EmailStatus
  /// Why it was captured, or the provider's error when it failed.
  detail     String?
  providerId String?
  html       String
  orderId    String?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@map("email_logs")
}

enum CustomerTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One-time links emailed to customers. Only a SHA-256 of the token is
/// stored, so a database leak can't be used to take over accounts.
model CustomerToken {
  id         String            @id @default(cuid())
  kind       CustomerTokenKind
  tokenHash  String            @unique
  expiresAt  DateTime
  usedAt     DateTime?
  customerId String
  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime          @default(now())

  @@index([customerId, kind])
  @@map("customer_tokens")
}
