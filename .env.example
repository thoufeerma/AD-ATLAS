# Copy to .env.local.
# Where the Velastia API runs. Read on the server only: pages fetch from it
# directly, and the browser reaches it through /api/v1 on this site
# (forwarded in proxy.ts), so the API never needs to accept cross-origin requests.
# The API must be running for `next build` too — pages are pre-rendered from it.
API_URL=http://localhost:4000

# The store's public address, e.g. https://velastia.com (no trailing slash).
# Used for the sitemap, robots.txt, link previews and Google product data.
SITE_URL=http://localhost:3000

# ── Online only ────────────────────────────────────────────────────────────
# Whether search engines may list the store is a switch in the admin, under
# SEO Settings (off until launch). Set this to "false" only on a copy that must
# never be listed whatever the admin says, such as a staging deployment.
# ALLOW_INDEXING=false
# The Supabase project URL (https://<project>.supabase.co), so product photos
# uploaded in the admin can be shown and optimised. Not a secret.
# SUPABASE_URL=
# Shared with the API (same value on the API and on the admin). Lets the API
# see each shopper's real IP address for its rate limits.
# PROXY_SECRET=
